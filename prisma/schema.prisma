datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  email               String    @unique
  name                String
  password            String?
  avatar              String?
  googleId            String?
  role                String    @default("USER") // "USER" | "ADMIN"
  phone               String?
  gender              String?   @default("Female")
  dateOfBirth         String?
  anniversary         String?
  whatsappUpdates     Boolean   @default(true)
  smsAlerts           Boolean   @default(true)
  catalogNewsletter   Boolean   @default(false)
  loyaltyPoints       Int       @default(4850)
  tier                String    @default("Gold Privilege Tier")
  twoFactorEnabled         Boolean   @default(true)
  isVerified               Boolean   @default(false)
  verificationOtp          String?
  verificationOtpExpiresAt DateTime?
  resetPasswordOtp         String?
  resetPasswordOtpExpiresAt DateTime?
  savedPaymentMethods      Json?
  addresses           Address[]
  orders              Order[]
  reviews             Review[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Address {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("Home") // "Home" | "Office" | "Other"
  name      String
  phone     String
  street    String
  locality  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  badge       String?  // e.g. "SALE", "HOT", "NEW"
  gender      String?  @default("all") // "women" | "men" | "all"
  showInMenu  Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  slug             String   @unique
  title            String
  price            String
  compareAtPrice   String?
  priceNum         Float
  rating           Float    @default(5.0)
  reviewsCount     Int      @default(0)
  primaryImage     String
  hoverImage       String?
  additionalImages String[]
  category         String
  gender           String?  @default("women") // "women" | "men" | "unisex"
  metal            String
  gemstone         String
  description      String
  aboutItem        String?
  soldCount        Int      @default(0)
  soldHours        Int      @default(24)
  stock            Int      @default(100)
  viewingCount     Int      @default(12)
  brand            String?  @default("ZHAEVAAH FINE JEWELLERY")
  discountBadge    String?
  sizes            Json?
  purityOptions    Json?
  stoneColors      Json?
  stoneShapes      Json?
  galleryImages    String[]
  specifications   Json?
  variantConfig    Json?
  isAvailable      Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  isBestSeller     Boolean  @default(false)
  reviews          Review[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Banner {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  subtitle     String?
  type         String   // "HERO" | "AD_DOUBLE" | "AD_SINGLE" | "PROMO_TOP" | "BRACELET_HOTSELL" | "DROP_CUT"
  image        String
  mobileImage  String?
  productImage String?
  link         String   @default("/shop")
  ctaText      String   @default("SHOP NOW")
  badge        String?
  discount     String?
  position     Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber       String   @unique
  userId            String?  @db.ObjectId
  user              User?    @relation(fields: [userId], references: [id])
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   Json
  items             Json
  subtotal          Float
  discount          Float    @default(0)
  couponCode        String?
  shippingFee       Float    @default(0)
  totalAmount       Float
  currency          String   @default("INR")
  paymentMethod     String   // "RAZORPAY" | "COD" | "CARD" | "UPI"
  paymentStatus     String   @default("PENDING") // "PENDING" | "PAID" | "FAILED"
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  orderStatus       String   @default("CONFIRMED") // "PENDING" | "CONFIRMED" | "PROCESSING" | "HALLMARKED" | "SHIPPED" | "IN_TRANSIT" | "DELIVERED" | "CANCELLED"
  carrier           String   @default("BlueDart Air")
  trackingNumber    String?
  deliveryEstimate  String?
  giftPackaging     Boolean  @default(false)
  giftNote          String?
  orderNote         String?
  trackingTimeline  Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Review {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  productId        String   @db.ObjectId
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?  @db.ObjectId
  user             User?    @relation(fields: [userId], references: [id])
  userName         String
  userAvatar       String?
  rating           Float
  comment          String
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  action      String   // e.g. "PRODUCT_CREATED", "ORDER_STATUS_UPDATED", "BANNER_UPDATED"
  entityType  String   // e.g. "Product", "Order", "Banner", "Category"
  entityId    String?
  adminEmail  String
  details     String
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model Transaction {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  transactionNumber  String   @unique
  orderNumber        String
  customerName       String
  customerEmail      String
  amount             Float
  gateway            String   // "Razorpay", "UPI", "Credit Card", "COD"
  gatewayPaymentId   String?
  status             String   // "SUCCESS", "PENDING", "FAILED", "REFUNDED"
  createdAt          DateTime @default(now())
}

model Setting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
